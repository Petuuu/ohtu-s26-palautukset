[MASTER]

ignore-paths=src/tests,.venv/
ignore=single_file_to_ignore.py

[MESSAGE CONTROL]

disable=missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring,
        import-error,
        too-few-public-methods

[FORMAT]
max-line-length=100
indent-string="    "

[REFACTORING]
max-nested-blocks=2

[DESIGN]
max-statements=10
max-args=5